{
  "_comment": "Written against a real Genesis 9 skeleton dump (138 bones, Asha 9, Daz Studio 6.25). See genesis9.bones.txt for the full tree with rotation orders.",
  "rig": "genesis9",
  "root": "hip",

  "_forward_comment": "Direction the figure faces, in Daz figure space. Verified from l_foot: the toes (end) sit at +Z from the ankle (origin).",
  "forward_daz": [0, 0, 1],

  "_chains_comment": "ik: true makes the chain's last bone an IK effector (grab it and the two bones above solve). Chains without it are reference only.",
  "chains": {
    "l_arm": {
      "ik": true,
      "bones": ["l_upperarm", "l_forearm", "l_hand"],
      "_shoulder_comment": "The clavicle carries a share of the reach before the two-bone solve. Without it the upper arm has to swing past its own limits and Daz corrects hard on commit. Its own limits are x[-30,30] y[-26,17] z[-10,55], hence the 30 deg cap.",
      "shoulder": "l_shoulder",
      "shoulder_weight": 0.4,
      "shoulder_max_deg": 30,
      "_roll_comment": "l_hand can only twist z[-70,80]; in a real arm the rest is forearm pronation. Rolling l_forearm about the elbow-to-wrist axis moves no joint, so the IK solution still holds. Daz drives the forearm twist bones from this on commit.",
      "roll_assist": true,
      "roll_max_deg": 90,
      "hinge": { "l_forearm": "y" },
      "twist": {
        "l_upperarm": ["l_upperarmtwist1", "l_upperarmtwist2"],
        "l_forearm":  ["l_forearmtwist1",  "l_forearmtwist2"]
      },
      "pole": "back"
    },
    "r_arm": {
      "ik": true,
      "bones": ["r_upperarm", "r_forearm", "r_hand"],
      "shoulder": "r_shoulder",
      "shoulder_weight": 0.4,
      "shoulder_max_deg": 30,
      "roll_assist": true,
      "roll_max_deg": 90,
      "hinge": { "r_forearm": "y" },
      "twist": {
        "r_upperarm": ["r_upperarmtwist1", "r_upperarmtwist2"],
        "r_forearm":  ["r_forearmtwist1",  "r_forearmtwist2"]
      },
      "pole": "back"
    },
    "l_leg": {
      "ik": true,
      "bones": ["l_thigh", "l_shin", "l_foot"],
      "hinge": { "l_shin": "x" },
      "twist": { "l_thigh": ["l_thightwist1", "l_thightwist2"] },
      "pole": "front"
    },
    "r_leg": {
      "ik": true,
      "bones": ["r_thigh", "r_shin", "r_foot"],
      "hinge": { "r_shin": "x" },
      "twist": { "r_thigh": ["r_thightwist1", "r_thightwist2"] },
      "pole": "front"
    },
    "spine": { "bones": ["spine1", "spine2", "spine3", "spine4"] },
    "neck":  { "bones": ["neck1", "neck2", "head"] }
  },

  "grabbable": [
    "hip", "pelvis",
    "spine1", "spine2", "spine3", "spine4",
    "neck1", "neck2", "head",
    "l_shoulder", "l_upperarm", "l_forearm", "l_hand",
    "r_shoulder", "r_upperarm", "r_forearm", "r_hand",
    "l_thigh", "l_shin", "l_foot", "l_toes",
    "r_thigh", "r_shin", "r_foot", "r_toes",
    "l_eye", "r_eye"
  ],

  "fingers": {
    "_comment": "Exposed as a group the user can toggle; hidden by default in VR.",
    "l_hand": ["l_thumb1", "l_thumb2", "l_thumb3",
               "l_index1", "l_index2", "l_index3",
               "l_mid1", "l_mid2", "l_mid3",
               "l_ring1", "l_ring2", "l_ring3",
               "l_pinky1", "l_pinky2", "l_pinky3"],
    "r_hand": ["r_thumb1", "r_thumb2", "r_thumb3",
               "r_index1", "r_index2", "r_index3",
               "r_mid1", "r_mid2", "r_mid3",
               "r_ring1", "r_ring2", "r_ring3",
               "r_pinky1", "r_pinky2", "r_pinky3"]
  },

  "hidden": {
    "_comment": "Never shown as handles in VR. Twist bones are written by the IK solver; the rest is face/desk work.",
    "patterns": [
      "*twist*",
      "*metacarpal", "*_metatarsal", "*_hand_anchor",
      "*toe1", "*toe2",
      "*_pectoral",
      "upperfacerig", "lowerfacerig", "lowerjaw", "chin",
      "upperteeth", "lowerteeth", "tongue*",
      "*lip*", "*brow*", "*cheek*", "*nostril*", "*squint", "*infraorbital", "*eyelid*",
      "l_ear", "r_ear"
    ]
  },

  "mirror": { "prefix_left": "l_", "prefix_right": "r_" },

  "rotation_orders_seen": { "YZX": 18, "ZYX": 58, "XYZ": 44, "XZY": 12, "ZXY": 6 }
}

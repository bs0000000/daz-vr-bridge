# Normalize line endings in the repo; checkout follows core.autocrlf.
* text=auto
*.ps1 text eol=crlf
*.bat text eol=crlf
*.png binary
*.dll binary

# Macros used by client/Daz VR Bridge/.gitattributes (Unity template).
# Git only honors [attr] macro definitions in the top-level file.
# No git-lfs in this repo: the template's "lfs" class is treated as plain binary.
[attr]lfs         binary
[attr]unity-json  eol=lf linguist-language=json
[attr]unity-yaml  merge=unityyamlmerge eol=lf linguist-language=yaml
